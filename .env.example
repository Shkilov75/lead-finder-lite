# Copy to .env.local and fill in DATABASE_URL. That file is gitignored.

# ---------------------------------------------------------------------------
# Required. The Supabase Postgres connection string.
#
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# **Transaction pooler**. Use that one, not "Direct connection":
#   * the direct host resolves to IPv6 only, which Vercel's Python functions
#     cannot be relied on to reach;
#   * every serverless invocation opens its own connection, and the pooler is
#     what stops a traffic spike exhausting Postgres' connection limit.
#
# Note the username carries the project ref (postgres.<ref>) and the port is
# 6543, not 5432 — both are how you can tell a pooler URL from a direct one.
#
# Never commit the filled-in value. On Vercel this is set as an Environment
# Variable in the project settings instead, not in any file.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ---------------------------------------------------------------------------
# Optional. Both have working defaults.
# ---------------------------------------------------------------------------

# Where next.config.ts forwards /api/* during `npm run dev`. Server-side only;
# the browser never sees this value, and it is ignored in production builds.
BACKEND_ORIGIN=http://localhost:8000

# Origins the FastAPI app answers CORS preflights for. Only matters for direct
# calls to the API port — the browser always talks to the app same-origin.
CORS_ORIGINS=http://localhost:3000
