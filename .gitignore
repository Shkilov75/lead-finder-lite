# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/.idea
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — ignore every .env variant, then re-admit the committed
# template. `.env*.local` alone missed a plain `.env`, which is the filename
# secrets most often land in.
.env
.env.*
!.env.example

# python backend (see also backend/.gitignore)
backend/.venv/
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
__pycache__/
*.py[cod]

# vercel — .vercel/ holds the linked org/project ids written by `vercel link`
.vercel

# supabase CLI — supabase/config.toml is meant to be committed; these are not.
# .temp/ caches the project ref and pooler credentials after `supabase link`.
.supabase/
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo
next-env.d.ts
